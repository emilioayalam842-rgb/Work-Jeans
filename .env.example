PORT=3001
# Contraseña inicial del panel (solo se usa la primera vez; después se guarda en admin-auth.json)
ADMIN_PASSWORD=cambia-esta-contrasena
# Cadena larga y aleatoria para firmar las sesiones del panel
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio
# Llave secreta de Stripe (sk_live_... o sk_test_...). Sin ella, solo funciona el pedido por WhatsApp.
STRIPE_SECRET_KEY=
# Carpeta persistente para datos del panel en hosting (p. ej. /data). Local: dejar vacío.
DATA_DIR=
# Dominio final del sitio. En producción: www.workjeans.mx (redirige el dominio sin www y http). Local: dejar vacío.
CANONICAL_HOST=
# Firma del webhook de Stripe (whsec_...). Se obtiene al crear el webhook en Stripe apuntando a /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Aviso por correo de cada pedido nuevo (opcional): llave de Resend y correo destino
RESEND_API_KEY=
NOTIFY_EMAIL=
# Remitente (opcional). Por defecto "Works Jeans <onboarding@resend.dev>", que solo entrega al correo dueño de la cuenta de Resend
NOTIFY_FROM=
